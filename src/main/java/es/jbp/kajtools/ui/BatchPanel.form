<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.iberia.seatsalgorithm.ui.BatchPanel">
  <grid id="27dc6" binding="contentPane" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="910e3" layout-manager="GridLayoutManager" row-count="5" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="10" left="10" bottom="10" right="10"/>
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="9089a" layout-manager="GridLayoutManager" row-count="1" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="1" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="790fd" class="javax.swing.JButton" binding="buttonExecute">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <icon value="images/execute.png"/>
                  <text value="Execute"/>
                </properties>
              </component>
              <hspacer id="154b4">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="2" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
              </hspacer>
              <component id="469ac" class="javax.swing.JButton" binding="buttonStop">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <enabled value="false"/>
                  <icon value="images/stop.png"/>
                  <text value=""/>
                  <toolTipText value="Stop"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="b2a5d" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="1" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="615" height="40"/>
              </grid>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="770f9" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Action:"/>
                </properties>
              </component>
              <component id="a5dce" class="javax.swing.JComboBox" binding="comboService">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
              </component>
            </children>
          </grid>
          <grid id="40c4f" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="c141f" class="javax.swing.JLabel">
                <constraints border-constraint="West"/>
                <properties>
                  <icon value="images/search.png"/>
                  <text value=""/>
                </properties>
              </component>
              <component id="19a26" class="javax.swing.JTextField" binding="searchTextField">
                <constraints border-constraint="Center"/>
                <properties>
                  <text value=""/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="68fb1" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="2" column="0" row-span="2" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <tabbedpane id="d5f84" binding="tabbedPane">
                <constraints border-constraint="Center"/>
                <properties/>
                <border type="none"/>
                <children>
                  <grid id="b8976" binding="tabInfo" layout-manager="BorderLayout" hgap="0" vgap="0">
                    <constraints>
                      <tabbedpane title-resource-bundle="messages" title-key="tab.info"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <scrollpane id="fdc44">
                        <constraints border-constraint="Center"/>
                        <properties/>
                        <border type="none"/>
                        <children>
                          <component id="41a9e" class="es.jbp.kajtools.ui.InfoTextPane" binding="infoTextPane">
                            <constraints/>
                            <properties>
                              <background color="-13948117"/>
                              <caretColor color="-1"/>
                              <contentType value="text/html"/>
                              <editable value="false"/>
                              <enabled value="true"/>
                              <font/>
                              <foreground color="-1"/>
                            </properties>
                          </component>
                        </children>
                      </scrollpane>
                    </children>
                  </grid>
                  <grid id="49e7d" binding="tabParam" layout-manager="BorderLayout" hgap="0" vgap="0">
                    <constraints>
                      <tabbedpane title="Parámetros"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <scrollpane id="a4959" class="org.fife.ui.rtextarea.RTextScrollPane" binding="paramScrollPane" custom-create="true">
                        <constraints border-constraint="Center"/>
                        <properties/>
                        <border type="none"/>
                        <children/>
                      </scrollpane>
                    </children>
                  </grid>
                </children>
              </tabbedpane>
              <grid id="3e68d" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
                <margin top="0" left="0" bottom="0" right="0"/>
                <constraints border-constraint="East"/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="2c767" class="javax.swing.JButton" binding="cleanButton" default-binding="true">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <icon value="images/rubber.png"/>
                      <text value=""/>
                      <toolTipText value="Limpiar"/>
                    </properties>
                  </component>
                  <component id="6783a" class="javax.swing.JButton" binding="copyButton">
                    <constraints>
                      <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <icon value="images/copy.png"/>
                      <text value=""/>
                      <toolTipText resource-bundle="messages" key="tooltip.copy.clipboard"/>
                    </properties>
                  </component>
                  <vspacer id="b97c5">
                    <constraints>
                      <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
                    </constraints>
                  </vspacer>
                  <vspacer id="f2654">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="1" anchor="1" fill="0" indent="0" use-parent-layout="false">
                        <preferred-size width="-1" height="30"/>
                      </grid>
                    </constraints>
                  </vspacer>
                </children>
              </grid>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
